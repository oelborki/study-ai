# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# NextAuth
NEXTAUTH_URL=https://quickynotes.com
NEXTAUTH_SECRET=generate-a-random-32-character-string

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Docker deployment
AUTH_TRUST_HOST=true

# Health Check (optional - for detailed health metrics)
HEALTH_CHECK_SECRET=generate-a-random-secret-for-health-endpoint

# File Storage (Cloudflare R2)
# Set STORAGE_PROVIDER=r2 for R2 storage, or omit/set to "local" for local filesystem
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=study-ai-files
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key

# Email (Resend)
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com

# Error Tracking (Sentry)
SENTRY_DSN=https://key@o123456.ingest.sentry.io/123456
NEXT_PUBLIC_SENTRY_DSN=https://key@o123456.ingest.sentry.io/123456
SENTRY_ORG=your-org
SENTRY_PROJECT=study-ai
SENTRY_AUTH_TOKEN=sntrys_token

# Logging
LOG_LEVEL=info

# Rate Limiting (Upstash Redis)
# Get these from https://upstash.com - free tier: 10K requests/day
# Rate limiting will be skipped if not configured (for local dev)
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
